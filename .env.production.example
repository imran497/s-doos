# Copy of what `npm run auth:setup` writes to .env.production. Never commit the real file.
DOMAIN=sellerdoos.kidbeestoys.com
SELLERDOOS_PASSWORD_HASH=scrypt:16384:8:1:...:...
SELLERDOOS_TOTP_SECRET=BASE32SECRET
SESSION_SECRET=random-string
# The encryption key from your computer's ~/.sellerdoos/master.key (base64).
SELLERDOOS_KEY=base64-key
