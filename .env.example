# Optional. Everything here can be entered in Settings instead (Amazon accounts connect with a
# "Connect" button there). Values set here take priority and are locked in Settings.
# Copy to .env.local and restart the app after changing.

# Keyword ranks and search volume (https://dataforseo.com, pay as you go). Recommended.
# API login and password from https://app.dataforseo.com/api-access (not your website login).
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Alternative rank source (https://www.rainforestapi.com). Used only if DataForSEO isn't set.
# With neither, SellerDoos shows demo data.
RAINFOREST_API_KEY=

# Amazon Selling Partner API: sales & traffic, orders, finances (profit), FBA inventory, BSR,
# prices/Buy Box, Search Query Performance and Top Search Terms. Brand Analytics needs Brand Registry.
# App roles: Brand Analytics, Selling Partner Insights, Product Listing, Pricing,
# Inventory and Order Tracking, Finance and Accounting.
SPAPI_APP_ID=
SPAPI_CLIENT_ID=
SPAPI_CLIENT_SECRET=
SPAPI_REFRESH_TOKEN=

# Amazon Ads API (Sponsored Products reports). Separate approval at advertising.amazon.com/API;
# the refresh token needs the advertising::campaign_management scope.
ADS_CLIENT_ID=
ADS_CLIENT_SECRET=
ADS_REFRESH_TOKEN=

# Optional
# DATABASE_PATH=./data/sellerdoos.db
# DISABLE_SCHEDULER=true
